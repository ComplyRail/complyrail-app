# Copy this file to .env.local and fill in the values you need.
# Only NEXT_PUBLIC_* values are exposed to the browser — never put secrets here.
# The build validates the required value and every value that is set.

# Stellar contract ID of the deployed ComplyRail contract (C followed by 55 base32 chars).
# Defaults to contracts/deployments/testnet.json, so it is only required if that file is empty.
NEXT_PUBLIC_CONTRACT_ID=

# Soroban RPC endpoint used for all contract reads and simulation.
# Defaults to https://soroban-testnet.stellar.org when unset.
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase; must match the network served by NEXT_PUBLIC_RPC_URL.
# Defaults to the public testnet passphrase when unset.
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Server-only settings for the audit index and its cron endpoint (never prefix with NEXT_PUBLIC_).
# Required by /api/audit/index; no build-time default.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CRON_SECRET=
